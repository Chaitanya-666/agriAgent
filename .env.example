# ==============================================================================
# AgriAgent Environment Configuration Example (.env.example)
# Copy this file to .env and configure your secrets.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

# --- Groq (cloud reasoning; free tier, no card) ---
# Create a key at https://console.groq.com/keys
# Used by HostedGroqProvider in src/agronomy/providers/hosted_groq.py
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# --- Cloudflare Workers AI (hosted Clef Flash triage, free 10k Neurons/day) ---
# Dashboard -> AI -> Workers AI -> "Use REST API": copy the Account ID and
# create a token with the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash

# --- Optional, not used in our plan (team decision, 17 Oct) ---
# Only Grounding DINO and SAM 2 run locally; reasoning uses Groq and Cloudflare.
# These local llama-server back-ends stay in the code as unused fallbacks.
# LOCAL_BASE_URL=http://127.0.0.1:8888/v1
# LOCAL_API_KEY=dummy
# LOCAL_MODEL_NAME=Qwen/Qwen3.5-4B
# CLEF_LOCAL_URL=http://127.0.0.1:8090
# CLEF_FLASH_MODEL=Cloudflare/clef-flash

# --- Hugging Face checkpoints ---
# Optional token for gated vision-model downloads.
HF_TOKEN=hf_your_huggingface_token_here
