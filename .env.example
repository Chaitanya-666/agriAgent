# ==============================================================================
# AgriAgent Environment Configuration Example (.env.example)
# Copy this file to .env and configure your secrets.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

# --- System 2 Hosted LLM Provider (Groq) ---
# API key from https://console.groq.com/keys
# Used by HostedGroqProvider in src/agronomy/providers/hosted_groq.py
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- System 2 Local LLM/VLM Provider (Qwen3.5-9B / vLLM / Ollama) ---
# Base URL of local OpenAI-compatible inference server (e.g., vLLM or Ollama)
# Used by LocalQwenProvider in src/agronomy/providers/local_qwen.py
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=dummy
LOCAL_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# --- Hugging Face Checkpoints & Model Hub ---
# Token for downloading SAM 2 and Grounding DINO weights if gated
HF_TOKEN=hf_your_huggingface_token_here

# --- Cloudflare Workers AI (Clef Flash Triage Router) ---
# Cloudflare API token with Workers AI read/write permissions
# Used by ClefFlashRouter in src/agents/clef_flash_router.py
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Cloudflare Account ID from dashboard overview
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
